# AgentOS 环境变量示例 — 复制为 .env 后填写真实值
# 注意：.env 已在 .gitignore 中，密钥永不入库、永不进日志

# 模型 API Keys（按需填写，数据库中只存这些变量名）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# 数据库（本地默认 SQLite，无需配置）
AGENTOS_DB_URL=sqlite:///data/agentos.db

# 本地模式
AGENTOS_MODE=local

# 本地管理接口防护（见 M1_PLAN_HANDOFF.md §11.8）
# 额外可信来源，逗号分隔（默认已含 http://localhost:5173 与 http://127.0.0.1:5173）
AGENTOS_TRUSTED_ORIGINS=
# 可选：设置后写请求必须携带 X-AgentOS-Token（脚本/CLI 客户端用）
AGENTOS_LOCAL_TOKEN=
# 危险：允许监听非回环地址，默认不要开启
AGENTOS_ALLOW_EXTERNAL=0

# ---------- M3-A 工具执行层 ----------
# 全局工具执行开关：默认 off。即使开了，仍需公司策略 + 员工工具白名单 + 工作区授权
AGENTOS_TOOL_EXECUTION=off
# 仅测试用：允许 http.request 访问白名单内的回环地址（默认 0，生产保持关闭）
AGENTOS_TOOL_HTTP_ALLOW_LOOPBACK=0
# 单次真实调用的最大输出 token（成本护栏）
AGENTOS_MAX_TOKENS=1024
